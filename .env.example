# Ingestion source: auto (default), synthetic, or polygon
# auto → synthetic when POLYGON_API_KEY is unset, else polygon
DECURSIO_INGEST_SOURCE=auto

# Polygon (only when ingest source is polygon or auto with a key set)
# POLYGON_API_KEY=
# POLYGON_WS_URL=wss://socket.polygon.io/stocks

# Symbols and storage
DECURSIO_SYMBOLS=AAPL
DUCKDB_PATH=data/market.duckdb

# Synthetic L2 feed (default path without an API key)
DECURSIO_SYNTHETIC_INTERVAL_SEC=0.5
DECURSIO_SYNTHETIC_DEPTH=5
# DECURSIO_SYNTHETIC_SEED=42

# Dashboard
DASH_HOST=127.0.0.1
DASH_PORT=8050
